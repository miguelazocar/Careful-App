# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# build outputs
dist/
*.apk
*.aab
coverage/

# signing secrets (keep them outside the repo)
signing.env
*.keystore
!android/app/debug.keystore

# Local native modules: Gradle output
modules/*/android/build/
modules/*/android/.cxx/
modules/*/android/.gradle/

# Google Cloud OAuth client downloads (not needed by the app: Android clients are matched by package + SHA-1)
client_secret_*.json
*.apps.googleusercontent.com.json
google-services.json
